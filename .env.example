# ---------- Firebase web config (browser-safe; access is enforced server-side) ----------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------- Firebase Admin (server only — never prefix with NEXT_PUBLIC_) ----------
# Service-account values from Project settings → Service accounts → Generate new private key.
# Keep the \n escapes in the private key, wrapped in double quotes.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=""

# ---------- File storage ----------
# "firestore" (default) stores uploads as chunks inside Firestore: free Spark plan and Vercel compatible.
# "firebase" uses a Storage bucket (Blaze plan). "local" writes to ./.data/uploads (local development only).
STORAGE_DRIVER=firestore
# Keep at 4 or below on Vercel (4.5 MB request body limit).
MAX_UPLOAD_MB=4

# ---------- AI (invoice content never leaves your machine with Ollama) ----------
# ollama | openrouter | none  (none = rules-only; the app works without any model)
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
AI_TIMEOUT_MS=90000

# OpenRouter sends invoice text to a third party. Use with synthetic data only.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct
